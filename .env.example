# ============================================================
# APA - CONFIGURACIÓN COMPLETA
# Copia este archivo como .env y rellena los valores
# ============================================================

# ── SANDBOX (obligatorio) ─────────────────────────────
# Tipo de entorno: local | nas | vm | external
SANDBOX_TYPE=local

# Ruta de trabajo en el sandbox
# SANDBOX_PATH=

# Solo para nas/vm/external:
# SANDBOX_HOST=192.168.1.100
# SANDBOX_USER=admin
# SANDBOX_SSH_PORT=22
# SANDBOX_SSH_KEY=~/.ssh/id_rsa
# SANDBOX_TIMEOUT=30
# SANDBOX_PYTHON_CMD=python3
# SANDBOX_NODE_CMD=node

# ── NAS (compatibilidad legacy) ──────────────────────
# Se usa automáticamente si SANDBOX_TYPE=nas no está configurado
# pero NAS_HOST sí lo está.
# NAS_HOST=
# NAS_USER=
# NAS_SANDBOX_PATH=/app/sandbox

# ── PROVEEDORES LLM (todos opcionales) ───────────────
# Sin claves: APA usa modelos gratuitos automáticamente
# a través de los proveedores que los ofrecen.
#
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GITHUB_TOKEN=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=     # 1M tokens/día gratuitos
# SILICONFLOW_API_KEY=  # 200M tokens/mes gratuitos
# SAMBANOVA_API_KEY=
# GOOGLE_API_KEY=       # Gemini
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# NOVITA_API_KEY=
# CLOUDFLARE_API_TOKEN=  # Workers AI
# CF_ACCOUNT_ID=         # ID de cuenta Cloudflare
# COHERE_API_KEY=
# HF_TOKEN=             # Hugging Face (conserva mayúsculas)
# OLLAMA_BASE_URL=http://localhost:11434

# ── COMPORTAMIENTO DEL SISTEMA ────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
DEFAULT_QUALITY_MODE=balanced  # fast | balanced | quality
PROVIDER_PRIORITY=cerebras,gemini,siliconflow,groq,deepseek,mistral,anthropic,openai,openrouter,together,github,fireworks,ollama,novita,sambanova,cloudflare,cohere,huggingface
USAGE_DB_PATH=apa/data/usage.db

# ── ARENA / RANKING ─────────────────────────────────
USE_ARENA_RANKINGS=True
ARENA_CACHE_TTL_HOURS=24
ARENA_API_TIMEOUT_SEC=1.5
ARENA_ELITE_THRESHOLD=1250
